# Drixel Platform production environment contract
# Never commit real secrets. Configure these in the hosting provider.

NODE_ENV=production
PORT=3000

# API database connections. Use separate least-privilege users in production.
DIRECTORY_DATABASE_URL=postgresql://drixel_directory_reader:REPLACE@HOST:5432/drixel_platform
MANAGEMENT_DATABASE_URL=postgresql://drixel_management_api:REPLACE@HOST:5432/drixel_platform
PGSSL=require
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=8
PGCONNECT_TIMEOUT_MS=5000
PGIDLE_TIMEOUT_MS=30000

# Used only by `npm run db:provision`; do not expose to the running API service.
ADMIN_DATABASE_URL=postgresql://ADMIN_USER:REPLACE@HOST:5432/drixel_platform
POSTGRES_DIRECTORY_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
POSTGRES_MANAGEMENT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET

# Drixel ID / OIDC. All production endpoints must use HTTPS.
OIDC_ISSUER=https://id.drixelsa.co.za/realms/drixel
OIDC_AUDIENCE=drixel-platform-api
OIDC_CLIENT_ID=drixel-platform-console
OIDC_JWKS_URI=https://id.drixelsa.co.za/realms/drixel/protocol/openid-connect/certs

# Frontend build-time OIDC configuration.
VITE_OIDC_ISSUER=https://id.drixelsa.co.za/realms/drixel
VITE_OIDC_AUTHORIZATION_ENDPOINT=https://id.drixelsa.co.za/realms/drixel/protocol/openid-connect/auth
VITE_OIDC_TOKEN_ENDPOINT=https://id.drixelsa.co.za/realms/drixel/protocol/openid-connect/token
VITE_OIDC_CLIENT_ID=drixel-platform-console
VITE_OIDC_AUDIENCE=drixel-platform-api

# Optional one-time first owner bootstrap. Set all four together when provisioning.
OIDC_BOOTSTRAP_ADMIN_EMAIL=
OIDC_BOOTSTRAP_ADMIN_NAME=
OIDC_BOOTSTRAP_ADMIN_SUBJECT=
# OIDC_ISSUER above is reused for the bootstrap issuer.

# Cloudflare Worker variable (configure in Workers > drixel-platform > Variables).
# Must point to the public HTTPS origin of the production Node API.
API_ORIGIN=https://api-platform.example-host.app
