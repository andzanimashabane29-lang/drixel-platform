{
  "realm": "drixel",
  "enabled": true,
  "displayName": "Drixel ID",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "drixel-platform-console",
      "name": "Drixel Platform Console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5177/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5177"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5177/*"
      },
      "protocolMappers": [
        {
          "name": "Drixel Platform API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "drixel-platform-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "a-chatz-supabase",
      "name": "A-Chatz Supabase Auth",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://poonntsdomkzfqidboug.supabase.co/auth/v1/callback"
      ],
      "webOrigins": []
    },
    {
      "clientId": "drixel-sa-firebase",
      "name": "Drixel SA Firebase Auth",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://drixel-sa.firebaseapp.com/__/auth/handler"
      ],
      "webOrigins": []
    }
  ]
}
