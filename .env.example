# Local development only. Change before any shared or production deployment.
# Local Drixel ID (Keycloak) administrator credentials. Use a strong local password.
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-keycloak-password
KEYCLOAK_PORT=8080
POSTGRES_DB=drixel_platform
POSTGRES_USER=drixel_admin
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
POSTGRES_DIRECTORY_PASSWORD=change-this-directory-password
POSTGRES_MANAGEMENT_PASSWORD=change-this-management-password
API_PORT=3000
# Local Drixel ID realm values. Use HTTPS URLs for shared deployments.
OIDC_ISSUER=http://localhost:8080/realms/drixel
OIDC_AUDIENCE=drixel-platform-api
OIDC_CLIENT_ID=drixel-platform-console
OIDC_JWKS_URI=http://keycloak:8080/realms/drixel/protocol/openid-connect/certs
VITE_OIDC_ISSUER=http://localhost:8080/realms/drixel
VITE_OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/drixel/protocol/openid-connect/auth
VITE_OIDC_TOKEN_ENDPOINT=http://localhost:8080/realms/drixel/protocol/openid-connect/token
VITE_OIDC_CLIENT_ID=drixel-platform-console
VITE_OIDC_AUDIENCE=drixel-platform-api
# Set these only when bootstrapping the first group owner.
OIDC_BOOTSTRAP_ADMIN_EMAIL=
OIDC_BOOTSTRAP_ADMIN_NAME=
OIDC_BOOTSTRAP_ADMIN_SUBJECT=
